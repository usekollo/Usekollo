// Postgres schema — see /docs/04-data-model.md for the full rationale.
//
// Identity is a Supabase Auth user; the Stellar public key is a nullable
// column on it, set only after the user links a wallet.
//
// What is and is not stored here:
//   - Goal state and balances are NOT cached. The contract is the source of
//     truth and `get_goals` resolves an owner's entire portfolio in one
//     simulated call, so reading through to the chain is both simpler and
//     always correct. There is no cache to fall out of sync.
//   - Activity IS stored, because Soroban RPC only retains events for about a
//     week and the activity feed needs to outlive that window.
//
// Prisma is the schema source of truth and the migration generator. Two things
// it cannot express live in a hand-written migration alongside the generated
// ones (see prisma/migrations/*_rls_and_auth_triggers): row level security,
// and the trigger mirroring auth.users into public.users.

// Prisma 7's generator. Unlike the deprecated prisma-client-js it emits plain
// TypeScript to a path we choose rather than into node_modules, so the output
// directory is gitignored and regenerated by `pnpm db:generate`.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts connection URLs here. The migration connection
// lives in prisma.config.ts (DIRECT_URL, the session pooler); the runtime
// connection is passed to PrismaClient as a driver adapter (DATABASE_URL, the
// transaction pooler).
datasource db {
  provider = "postgresql"
}

model User {
  // Mirrors auth.users.id. Not a foreign key: the auth schema lives outside
  // the tables Prisma manages. Nothing cascades on its own as a result, so
  // inserts, email changes and deletes are all mirrored by triggers — see
  // prisma/migrations/*_rls_and_auth_triggers and
  // *_auth_user_delete_trigger. Without the delete trigger a removed account
  // left a profile row holding its address in users_email_idx, which made
  // that address permanently unregisterable.
  id       String  @id @db.Uuid
  email    String
  fullName String  @default("") @map("full_name")
  avatarUrl String? @map("avatar_url")

  // Null until the user connects Freighter. Ownership is proven by signing a
  // nonce (see WalletChallenge) before this is written, so it cannot be set
  // to an address the user does not control.
  stellarPublicKey   String?   @map("stellar_public_key")
  walletConnectedAt  DateTime? @map("wallet_connected_at") @db.Timestamptz(6)
  walletLastSyncedAt DateTime? @map("wallet_last_synced_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // The auth.users email-change trigger also bumps this, so the column stays
  // correct for writes that never go through Prisma.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  walletChallenges WalletChallenge[]
  activity         Activity[]
  emailOtps        EmailOtp[]

  @@unique([email], map: "users_email_idx")
  // Two accounts must not claim the same wallet. Postgres treats NULLs as
  // distinct, so unconnected accounts don't collide.
  @@unique([stellarPublicKey], map: "users_stellar_public_key_idx")
  @@map("users")
}

// One row per "prove you hold this key" attempt. Short-lived and single-use:
// the connect endpoint verifies the signature, stamps `consumedAt`, and will
// not accept the same nonce twice (which is what stops a captured signature
// being replayed).
model WalletChallenge {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  publicKey  String    @map("public_key")
  nonce      String
  // The exact unsigned challenge transaction handed to the wallet. Stored
  // rather than rebuilt at verification time: the previous message-based
  // challenge embedded a timestamp, and rebuilding it from a different clock
  // made every signature fail to verify. Comparing against what we actually
  // issued removes that whole class of bug. Nullable for rows predating this.
  challengeXdr String?  @map("challenge_xdr")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "wallet_challenges_user_idx")
  @@unique([nonce], map: "wallet_challenges_nonce_idx")
  @@map("wallet_challenges")
}

model Activity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Null for a create that failed before the contract assigned an id.
  goalId BigInt? @map("goal_id")
  // Denormalised so the feed can render "Deposit to New Laptop" without a
  // round trip to the chain for a goal that may since have been withdrawn.
  goalName String? @map("goal_name")

  // The Stellar account, which is the identity the chain knows. `userId` is
  // the app account that submitted it — null for rows the indexer recovered
  // from on-chain events that no app account has claimed.
  owner  String
  userId String? @map("user_id") @db.Uuid

  // 'create' | 'deposit' | 'withdrawal'
  type      String
  amount    Decimal? @db.Decimal(20, 7)
  assetCode String?  @map("asset_code")
  // 'success' | 'pending' | 'failed'
  status String

  txHash         String   @map("tx_hash")
  ledgerSequence BigInt?  @map("ledger_sequence")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([owner, createdAt], map: "activity_owner_created_idx")
  @@index([goalId, createdAt], map: "activity_goal_created_idx")
  // The API route writes a row the moment it submits, and the cron indexer
  // later replays the same on-chain event. This is what makes that second
  // write a no-op rather than a duplicate in the feed.
  @@unique([txHash, type], map: "activity_tx_hash_type_idx")
  @@map("activity")
}

// How far the indexer has replayed. One row, keyed by contract, so pointing
// the app at a freshly deployed contract starts a clean scan.
model IndexerCheckpoint {
  contractId String   @id @map("contract_id")
  lastLedger BigInt   @map("last_ledger")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("indexer_checkpoint")
}

// One row per emailed 6-digit code.
//
// Supabase Auth mints codes too, but its "Email OTP Length" is a project-level
// setting (8 on this project) that the app cannot change at runtime, and the
// UI is built for 6. So the app owns the code lifecycle end to end: it mints,
// stores, expires and verifies, then tells Supabase the address is confirmed
// via the admin API. Nothing here replaces Supabase as the identity provider —
// passwords and sessions are still entirely its concern.
model EmailOtp {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  // Denormalised from the user so verification is one indexed lookup on the
  // only thing the request actually carries.
  email String

  // 'signup' | 'recovery'. A code minted to confirm an address must not be
  // usable to authorise a password reset, so the purpose is part of the
  // lookup rather than advisory.
  purpose String

  // HMAC-SHA256 of the code, keyed with JWT_SECRET — never the code itself.
  // A bare digest would be pointless here: six digits is a million
  // possibilities, which is seconds of brute force against a leaked table.
  // The key is what makes the stored value useless without the app secret.
  codeHash String @map("code_hash")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  // Capped, so a code cannot be guessed by submitting a million requests
  // against a single live row.
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt], map: "email_otp_lookup_idx")
  @@index([userId], map: "email_otp_user_idx")
  @@map("email_otp")
}
